/* ==========================================================
   LAVANYA PORTFOLIO - JAVASCRIPT
   Modules: theme, navigation, scroll effects, typing,
   reveal animations, counters, skill bars, card effects,
   particle background
========================================================== */

(() => {
    "use strict";

    const $ = (selector, scope = document) => scope.querySelector(selector);
    const $$ = (selector, scope = document) => [...scope.querySelectorAll(selector)];

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ------------------------------------------------------
       PROFILE DATA (edit here to update the typing text)
    ------------------------------------------------------ */
    const profile = {
        name: "Lavanya Sivakumar",
        department: "Information Technology",
        college: "KGISL College",
        year: "2nd Year",
        roles: [
            "Information Technology Student",
            "Hackathon Participant",
            "Python & Java Learner",
            "Future Innovator"
        ]
    };

    /* ------------------------------------------------------
       1. THEME TOGGLE (saved in localStorage)
    ------------------------------------------------------ */
    const root = document.documentElement;
    const themeToggle = $("#themeToggle");

    const getSavedTheme = () => {
        try { return localStorage.getItem("portfolio-theme"); } catch { return null; }
    };

    const saveTheme = (theme) => {
        try { localStorage.setItem("portfolio-theme", theme); } catch { /* ignore */ }
    };

    const applyTheme = (theme) => {
        root.setAttribute("data-theme", theme);
        const meta = $('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#070a11" : "#f6f8fc");
    };

    const initialTheme =
        getSavedTheme() ||
        (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");

    applyTheme(initialTheme);

    themeToggle.addEventListener("click", () => {
        const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        applyTheme(next);
        saveTheme(next);
    });

    /* ------------------------------------------------------
       2. NAVIGATION (smooth scroll, mobile menu, active link)
    ------------------------------------------------------ */
    const nav = $("#nav");
    const menu = $("#menu");
    const burger = $("#burger");
    const navLinks = $$(".nav-link");

    const goToSection = (id) => {
        const target = document.getElementById(id);
        if (target) target.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth" });
    };

    const setMenu = (open) => {
        menu.classList.toggle("open", open);
        burger.classList.toggle("open", open);
        burger.setAttribute("aria-expanded", String(open));
        burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    burger.addEventListener("click", () => setMenu(!menu.classList.contains("open")));

    navLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
            event.preventDefault();
            goToSection(link.getAttribute("href").slice(1));
            setMenu(false);
        });
    });

    // Buttons with data-scroll="sectionId"
    $$("[data-scroll]").forEach((button) => {
        button.addEventListener("click", () => goToSection(button.dataset.scroll));
    });

    // Logo click
    $(".logo").addEventListener("click", (event) => {
        event.preventDefault();
        goToSection("home");
    });

    // Close mobile menu with Escape or outside click
    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenu(false);
    });

    document.addEventListener("click", (event) => {
        if (!menu.contains(event.target) && !burger.contains(event.target)) setMenu(false);
    });

    // Highlight the active section in the navbar
    const sections = $$("main section[id]");

    const sectionObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                navLinks.forEach((link) => {
                    link.classList.toggle("active", link.getAttribute("href") === `#${entry.target.id}`);
                });
            });
        },
        { rootMargin: "-45% 0px -50% 0px" }
    );

    sections.forEach((section) => sectionObserver.observe(section));

    /* ------------------------------------------------------
       3. SCROLL EFFECTS (progress bar, navbar, back-to-top)
    ------------------------------------------------------ */
    const progressBar = $("#scrollProgress");
    const toTop = $("#toTop");
    let scrollTicking = false;

    const onScroll = () => {
        const scrollTop = window.scrollY;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const progress = maxScroll > 0 ? (scrollTop / maxScroll) * 100 : 0;

        progressBar.style.width = `${progress}%`;
        nav.classList.toggle("scrolled", scrollTop > 20);
        toTop.classList.toggle("show", scrollTop > 600);

        scrollTicking = false;
    };

    window.addEventListener(
        "scroll",
        () => {
            if (!scrollTicking) {
                window.requestAnimationFrame(onScroll);
                scrollTicking = true;
            }
        },
        { passive: true }
    );

    toTop.addEventListener("click", () => goToSection("home"));
    onScroll();

    /* ------------------------------------------------------
       4. TYPING EFFECT
    ------------------------------------------------------ */
    const typingEl = $("#typing");

    const runTyping = () => {
        if (prefersReducedMotion) {
            typingEl.textContent = profile.roles[0];
            return;
        }

        let roleIndex = 0;
        let charIndex = 0;
        let deleting = false;

        const tick = () => {
            const current = profile.roles[roleIndex];
            charIndex += deleting ? -1 : 1;
            typingEl.textContent = current.slice(0, charIndex);

            let delay = deleting ? 40 : 85;

            if (!deleting && charIndex === current.length) {
                deleting = true;
                delay = 1600;
            } else if (deleting && charIndex === 0) {
                deleting = false;
                roleIndex = (roleIndex + 1) % profile.roles.length;
                delay = 400;
            }

            setTimeout(tick, delay);
        };

        tick();
    };

    runTyping();

    /* ------------------------------------------------------
       5. REVEAL ON SCROLL
    ------------------------------------------------------ */
    const revealObserver = new IntersectionObserver(
        (entries, observer) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
            });
        },
        { threshold: 0.15 }
    );

    $$(".reveal").forEach((el) => revealObserver.observe(el));

    /* ------------------------------------------------------
       6. COUNTERS (hero stats)
    ------------------------------------------------------ */
    const animateCounter = (el) => {
        const target = Number(el.dataset.count);
        const suffix = el.dataset.suffix || "";
        const duration = 1400;

        if (prefersReducedMotion) {
            el.textContent = target + suffix;
            return;
        }

        const start = performance.now();

        const step = (now) => {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (progress < 1) requestAnimationFrame(step);
        };

        requestAnimationFrame(step);
    };

    const counterObserver = new IntersectionObserver(
        (entries, observer) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                animateCounter(entry.target);
                observer.unobserve(entry.target);
            });
        },
        { threshold: 0.6 }
    );

    $$("[data-count]").forEach((el) => counterObserver.observe(el));

    /* ------------------------------------------------------
       7. SKILL BARS
       Change data-level (0-100) in index.html to edit levels
    ------------------------------------------------------ */
    const skillObserver = new IntersectionObserver(
        (entries, observer) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const fill = $(".bar-fill", entry.target);
                fill.style.width = `${entry.target.dataset.level}%`;
                observer.unobserve(entry.target);
            });
        },
        { threshold: 0.4 }
    );

    $$(".skill-card").forEach((card) => skillObserver.observe(card));

    /* ------------------------------------------------------
       8. CARD EFFECTS (3D tilt + cursor spotlight)
    ------------------------------------------------------ */
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    if (canHover && !prefersReducedMotion) {
        $$(".tilt").forEach((card) => {
            card.addEventListener("mousemove", (event) => {
                const rect = card.getBoundingClientRect();
                const x = event.clientX - rect.left;
                const y = event.clientY - rect.top;
                const rotateX = ((y / rect.height) - 0.5) * -8;
                const rotateY = ((x / rect.width) - 0.5) * 8;

                card.style.setProperty("--mx", `${x}px`);
                card.style.setProperty("--my", `${y}px`);

                if (!card.classList.contains("code-window")) {
                    card.style.transform =
                        `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
                }
            });

            card.addEventListener("mouseleave", () => {
                card.style.transform = "";
            });
        });
    }

    /* ------------------------------------------------------
       9. FOOTER YEAR
    ------------------------------------------------------ */
    $("#year").textContent = new Date().getFullYear();

    /* ------------------------------------------------------
       10. PARTICLE NETWORK BACKGROUND
    ------------------------------------------------------ */
    const canvas = $("#bgCanvas");
    const ctx = canvas.getContext("2d");
    let particles = [];
    let width = 0;
    let height = 0;
    const mouse = { x: null, y: null };

    const getAccentColor = () =>
        getComputedStyle(root).getPropertyValue("--accent").trim() || "#00e5a8";

    const resizeCanvas = () => {
        const ratio = window.devicePixelRatio || 1;
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = width * ratio;
        canvas.height = height * ratio;
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

        const count = Math.min(70, Math.floor((width * height) / 22000));
        particles = Array.from({ length: count }, () => ({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.35,
            vy: (Math.random() - 0.5) * 0.35,
            r: Math.random() * 1.6 + 0.6
        }));
    };

    const drawParticles = () => {
        ctx.clearRect(0, 0, width, height);
        const color = getAccentColor();
        const linkDistance = 130;

        particles.forEach((p, i) => {
            p.x += p.vx;
            p.y += p.vy;

            if (p.x < 0 || p.x > width) p.vx *= -1;
            if (p.y < 0 || p.y > height) p.vy *= -1;

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = color;
            ctx.globalAlpha = 0.8;
            ctx.fill();

            for (let j = i + 1; j < particles.length; j++) {
                const q = particles[j];
                const dist = Math.hypot(p.x - q.x, p.y - q.y);
                if (dist < linkDistance) {
                    ctx.beginPath();
                    ctx.moveTo(p.x, p.y);
                    ctx.lineTo(q.x, q.y);
                    ctx.strokeStyle = color;
                    ctx.globalAlpha = (1 - dist / linkDistance) * 0.25;
                    ctx.lineWidth = 1;
                    ctx.stroke();
                }
            }

            // Connect particles to the mouse
            if (mouse.x !== null) {
                const md = Math.hypot(p.x - mouse.x, p.y - mouse.y);
                if (md < 160) {
                    ctx.beginPath();
                    ctx.moveTo(p.x, p.y);
                    ctx.lineTo(mouse.x, mouse.y);
                    ctx.strokeStyle = color;
                    ctx.globalAlpha = (1 - md / 160) * 0.5;
                    ctx.stroke();
                }
            }
        });

        ctx.globalAlpha = 1;
        requestAnimationFrame(drawParticles);
    };

    resizeCanvas();
    window.addEventListener("resize", resizeCanvas);

    window.addEventListener("mousemove", (event) => {
        mouse.x = event.clientX;
        mouse.y = event.clientY;
    });

    window.addEventListener("mouseleave", () => {
        mouse.x = null;
        mouse.y = null;
    });

    if (!prefersReducedMotion) {
        drawParticles();
    } else {
        canvas.style.display = "none";
    }

    /* ------------------------------------------------------
       CONSOLE GREETING
    ------------------------------------------------------ */
    console.log(
        `%c👋 Hi, I'm ${profile.name}`,
        "color:#00e5a8;font-size:16px;font-weight:bold;"
    );
    console.log(`${profile.department} | ${profile.college} | ${profile.year}`);
})();
