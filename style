/* ========================================
   GENERAL
======================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #080b12;
    color: white;
}


/* ========================================
   NAVIGATION
======================================== */

nav {
    position: fixed;
    top: 0;
    width: 100%;
    height: 70px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 0 7%;

    background: rgba(8, 11, 18, 0.95);

    border-bottom: 1px solid #252b38;

    z-index: 1000;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    color: #00e5a8;
}

.menu {
    display: flex;
    gap: 25px;
}

.menu a {
    color: #b5bcc8;
    text-decoration: none;
    font-size: 14px;
}

.menu a:hover {
    color: #00e5a8;
}


/* ========================================
   COMMON PAGE
======================================== */

.page {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 100px 8%;

    border-bottom: 1px solid #252b38;
}

.content {
    width: 100%;
    max-width: 1100px;
}

.small-text {
    color: #00e5a8;
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

.content h1 {
    font-size: 60px;
    margin-bottom: 20px;
}

.description {
    color: #a7afbb;
    font-size: 20px;
    line-height: 1.8;
}


/* ========================================
   HOME
======================================== */

.home {
    background:
        radial-gradient(circle at 80% 30%, #123b38 0%, transparent 30%),
        #080b12;
}

.home h1 {
    font-size: 30px;
    color: #b8bec8;
}

.home h2 {
    font-size: 75px;
    color: #00e5a8;
    margin-bottom: 25px;
}


/* ========================================
   BUTTON
======================================== */

.next-btn,
.top-btn {
    margin-top: 30px;

    padding: 15px 25px;

    border: none;

    background: #00e5a8;

    color: #06100d;

    font-size: 15px;

    font-weight: bold;

    cursor: pointer;

    border-radius: 5px;
}

.next-btn:hover,
.top-btn:hover {
    background: white;
}


/* ========================================
   ABOUT
======================================== */

.about {
    background: #0d1119;
}

.about .content {
    max-width: 850px;
}

.about p:not(.small-text) {
    color: #aeb5c0;
    font-size: 18px;
    line-height: 1.9;
    margin-bottom: 20px;
}

.large-text {
    font-size: 24px !important;
    color: white !important;
}


/* ========================================
   SKILLS
======================================== */

.skills {
    background: #080b12;
}

.skill-container {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;

    margin-top: 40px;
}

.skill-card {
    padding: 30px;

    background: #111722;

    border: 1px solid #29313e;

    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-8px);

    border-color: #00e5a8;

    background: #13201f;
}

.skill-card h3 {
    color: #00e5a8;

    font-size: 25px;

    margin-bottom: 10px;
}

.skill-card p {
    color: #8f98a5;
}


/* ========================================
   ACHIEVEMENTS
======================================== */

.achievements {
    background: #0d1119;
}

.achievement-container {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;

    margin-top: 40px;
}

.achievement-card {
    padding: 35px;

    min-height: 230px;

    background: #111722;

    border: 1px solid #29313e;

    transition: 0.3s;
}

.achievement-card:hover {
    transform: translateY(-8px);

    border-color: #00e5a8;
}

.achievement-card span {
    color: #00e5a8;

    font-size: 13px;
}

.achievement-card h3 {
    font-size: 27px;

    margin: 40px 0 15px;
}

.achievement-card p {
    color: #929aa7;

    line-height: 1.7;
}


/* ========================================
   GOAL
======================================== */

.goal {
    background:
        radial-gradient(circle at 50% 50%, #123b38 0%, transparent 40%),
        #080b12;
}

.goal .content {
    max-width: 850px;
}

.goal p:not(.small-text) {
    color: #aeb5c0;

    font-size: 18px;

    line-height: 1.9;

    margin-bottom: 20px;
}

.goal .large-text {
    color: #00e5a8 !important;

    font-size: 35px !important;

    font-weight: bold;
}


/* ========================================
   FOOTER
======================================== */

footer {
    padding: 30px;

    text-align: center;

    background: #05070b;

    color: #69717d;

    font-size: 14px;
}


/* ========================================
   MOBILE RESPONSIVE
======================================== */

@media (max-width: 800px) {

    nav {
        height: auto;

        padding: 15px 5%;

        flex-direction: column;

        gap: 15px;
    }

    .menu {
        gap: 12px;

        flex-wrap: wrap;

        justify-content: center;
    }

    .home h2 {
        font-size: 48px;
    }

    .content h1 {
        font-size: 42px;
    }

    .skill-container,
    .achievement-container {
        grid-template-columns: 1fr;
    }

    .page {
        padding: 120px 6% 70px;
    }
}
