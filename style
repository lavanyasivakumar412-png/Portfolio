/* ========================================
   LAVANYA PORTFOLIO - CSS
======================================== */


/* ========================================
   VARIABLES
======================================== */

:root {
    --navy: #14213d;
    --blue: #0077b6;
    --blue-dark: #023e8a;
    --sky: #dff6ff;
    --bg: #f4f7fb;
    --white: #ffffff;
    --text: #222222;
    --muted: #55607a;
    --shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    --shadow-hover: 0 14px 30px rgba(0, 119, 182, 0.18);
}


/* ========================================
   GENERAL STYLING
======================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
}

body {
    font-family: "Poppins", Arial, sans-serif;
    background-color: var(--bg);
    color: var(--text);
    line-height: 1.6;
}


/* ========================================
   NAVIGATION
======================================== */

nav {
    background-color: rgba(20, 33, 61, 0.95);
    backdrop-filter: blur(8px);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 8%;
    position: sticky;
    top: 0;
    z-index: 1000;
    transition: box-shadow 0.3s, padding 0.3s;
}

nav.scrolled {
    padding: 12px 8%;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
}

nav h2 {
    font-size: 26px;
    letter-spacing: 0.5px;
}

.nav-links {
    display: flex;
    gap: 25px;
}

.nav-links a {
    position: relative;
    color: white;
    text-decoration: none;
    font-size: 16px;
    padding: 4px 0;
    transition: color 0.3s;
}

.nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background-color: #00b4d8;
    transition: width 0.3s;
}

.nav-links a:hover,
.nav-links a.active {
    color: #00b4d8;
}

.nav-links a:hover::after,
.nav-links a.active::after {
    width: 100%;
}


/* ========================================
   HOME SECTION
======================================== */

.hero {
    min-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    background:
        radial-gradient(circle at 20% 20%, #ffffff 0%, transparent 40%),
        linear-gradient(135deg, #dff6ff 0%, #c4e9fb 100%);
    padding: 40px 20px;
}

.hero-content {
    max-width: 750px;
}

.small-title {
    color: var(--blue);
    font-weight: bold;
    letter-spacing: 2px;
    font-size: 14px;
}

.hero h1 {
    font-size: 55px;
    margin: 15px 0;
    color: var(--navy);
}

.hero h1 span {
    background: linear-gradient(90deg, #0077b6, #00b4d8);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.hero h2 {
    font-size: 28px;
    margin-bottom: 20px;
    color: var(--navy);
}

.hero p {
    font-size: 19px;
    margin-bottom: 25px;
    color: var(--muted);
}


/* ========================================
   BUTTON
======================================== */

.btn {
    background-color: var(--blue);
    color: white;
    border: none;
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s, transform 0.3s, box-shadow 0.3s;
}

.btn:hover {
    background-color: var(--blue-dark);
    transform: translateY(-3px);
    box-shadow: 0 10px 22px rgba(0, 119, 182, 0.35);
}


/* ========================================
   SECTIONS
======================================== */

section {
    padding: 80px 8%;
}

.section-title {
    text-align: center;
    font-size: 35px;
    color: var(--navy);
    margin-bottom: 40px;
}

.section-title::after {
    content: "";
    display: block;
    width: 60px;
    height: 4px;
    margin: 12px auto 0;
    background-color: var(--blue);
    border-radius: 4px;
}


/* ========================================
   SCROLL ANIMATION
======================================== */

.reveal {
    opacity: 0;
    transform: translateY(35px);
    transition: opacity 0.7s ease, transform 0.7s ease;
}

.reveal.show {
    opacity: 1;
    transform: translateY(0);
}


/* ========================================
   ABOUT
======================================== */

.about-box {
    max-width: 850px;
    margin: auto;
    background-color: var(--white);
    padding: 35px;
    border-radius: 12px;
    border-left: 5px solid var(--blue);
    box-shadow: var(--shadow);
}

.about-box p {
    font-size: 18px;
    margin-bottom: 15px;
    color: var(--muted);
}

.about-box p:last-child {
    margin-bottom: 0;
}


/* ========================================
   SKILLS
======================================== */

.skills-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.skill {
    background-color: var(--white);
    padding: 30px;
    text-align: center;
    border-radius: 12px;
    border: 2px solid transparent;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: var(--shadow);
}

.skill:hover,
.skill.active {
    transform: translateY(-8px);
    background-color: var(--sky);
    border-color: var(--blue);
    box-shadow: var(--shadow-hover);
}

.skill h3 {
    color: var(--blue);
    margin-bottom: 10px;
}

.skill p {
    color: var(--muted);
}


/* ========================================
   EVENTS / PROJECTS
======================================== */

.projects-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.project {
    background-color: var(--white);
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: var(--shadow);
    border-top: 4px solid var(--blue);
}

.project:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-hover);
}

.project-num {
    display: inline-block;
    margin-bottom: 12px;
    padding: 4px 12px;
    font-size: 13px;
    font-weight: bold;
    color: var(--blue);
    background-color: var(--sky);
    border-radius: 20px;
}

.project h3 {
    color: var(--blue);
    margin-bottom: 15px;
}

.project p {
    font-size: 17px;
    color: var(--muted);
}


/* ========================================
   FOOTER
======================================== */

footer {
    background-color: var(--navy);
    color: white;
    text-align: center;
    padding: 30px;
}

footer p {
    margin: 5px;
}


/* ========================================
   BACK TO TOP BUTTON
======================================== */

.to-top {
    position: fixed;
    right: 22px;
    bottom: 22px;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background-color: var(--blue);
    color: white;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0, 119, 182, 0.4);
    opacity: 0;
    transform: translateY(15px);
    pointer-events: none;
    transition: opacity 0.3s, transform 0.3s, background-color 0.3s;
    z-index: 900;
}

.to-top.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

.to-top:hover {
    background-color: var(--blue-dark);
}


/* ========================================
   RESPONSIVE DESIGN
======================================== */

@media (max-width: 768px) {

    nav,
    nav.scrolled {
        flex-direction: column;
        gap: 12px;
        padding: 14px 5%;
    }

    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
    }

    html {
        scroll-padding-top: 130px;
    }

    .hero h1 {
        font-size: 40px;
    }

    .hero h2 {
        font-size: 22px;
    }

    .skills-container,
    .projects-container {
        grid-template-columns: 1fr;
    }

    section {
        padding: 60px 5%;
    }
}
