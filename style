body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f2f6ff;
    color: #222;
}

header {
    background-color: #243b64;
    color: white;
    text-align: center;
    padding: 40px;
}

header h1 {
    font-size: 40px;
    margin-bottom: 10px;
}

header p {
    font-size: 20px;
}

section {
    width: 80%;
    margin: 25px auto;
    padding: 25px;
    background-color: white;
    border-radius: 10px;
}

section h2 {
    color: #243b64;
    border-bottom: 2px solid #243b64;
    padding-bottom: 10px;
}

section p {
    font-size: 18px;
    line-height: 1.6;
}

ul {
    padding-left: 30px;
}

li {
    font-size: 18px;
    margin: 10px;
}

footer {
    background-color: #243b64;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
}
