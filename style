/* ========================================
   LAVANYA PORTFOLIO - CSS
======================================== */


/* ========================================
   GENERAL STYLING
======================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f7fb;
    color: #222;
    line-height: 1.6;
}


/* ========================================
   NAVIGATION
======================================== */

nav {
    background-color: #14213d;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    position: sticky;
    top: 0;
    z-index: 1000;
}

nav h2 {
    font-size: 26px;
}

.nav-links {
    display: flex;
    gap: 25px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-size: 16px;
}

.nav-links a:hover {
    color: #00b4d8;
}


/* ========================================
   HOME SECTION
======================================== */

.hero {
    min-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    background-color: #dff6ff;
    padding: 40px 20px;
}

.hero-content {
    max-width: 750px;
}

.small-title {
    color: #0077b6;
    font-weight: bold;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: 55px;
    margin: 15px 0;
}

.hero h1 span {
    color: #0077b6;
}

.hero h2 {
    font-size: 28px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 19px;
    margin-bottom: 25px;
}


/* ========================================
   BUTTON
======================================== */

.btn {
    background-color: #0077b6;
    color: white;
    border: none;
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
}

.btn:hover {
    background-color: #023e8a;
}


/* ========================================
   SECTIONS
======================================== */

section {
    padding: 80px 8%;
}

.section-title {
    text-align: center;
    font-size: 35px;
    color: #14213d;
    margin-bottom: 40px;
}


/* ========================================
   ABOUT
======================================== */

.about-box {
    max-width: 850px;
    margin: auto;
    background-color: white;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
}

.about-box p {
    font-size: 18px;
    margin-bottom: 15px;
}


/* ========================================
   SKILLS
======================================== */

.skills-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.skill {
    background-color: white;
    padding: 30px;
    text-align: center;
    border-radius: 12px;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
}

.skill:hover,
.skill.active {
    transform: translateY(-8px);
    background-color: #dff6ff;
}

.skill h3 {
    color: #0077b6;
    margin-bottom: 10px;
}


/* ========================================
   EVENTS / PROJECTS
======================================== */

.projects-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.project {
    background-color: white;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
}

.project:hover {
    transform: translateY(-8px);
}

.project h3 {
    color: #0077b6;
    margin-bottom: 15px;
}

.project p {
    font-size: 17px;
}


/* ========================================
   FOOTER
======================================== */

footer {
    background-color: #14213d;
    color: white;
    text-align: center;
    padding: 30px;
}

footer p {
    margin: 5px;
}


/* ========================================
   RESPONSIVE DESIGN
======================================== */

@media (max-width: 768px) {

    nav {
        flex-direction: column;
        gap: 15px;
    }

    .nav-links {
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero h1 {
        font-size: 40px;
    }

    .skills-container,
    .projects-container {
        grid-template-columns: 1fr;
    }

    section {
        padding: 60px 5%;
    }
}
