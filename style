/* ==========================================================
   LAVANYA PORTFOLIO - STYLESHEET
   1. Variables   2. Base   3. Navigation   4. Layout
   5. Hero        6. About  7. Skills       8. Achievements
   9. Goal        10. Contact  11. Footer & extras
   12. Animations 13. Responsive
========================================================== */


/* ---------- 1. VARIABLES ---------- */

:root {
    --bg: #070a11;
    --bg-alt: #0b101a;
    --surface: #111826;
    --surface-2: #151e2f;
    --border: #232c3d;
    --text: #e8ecf3;
    --muted: #9aa4b5;
    --accent: #00e5a8;
    --accent-2: #38bdf8;
    --accent-soft: rgba(0, 229, 168, 0.12);
    --glow: rgba(0, 229, 168, 0.35);
    --nav-bg: rgba(7, 10, 17, 0.75);
    --shadow: 0 20px 50px rgba(0, 0, 0, 0.45);

    --font-body: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-head: "Space Grotesk", "Inter", sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;

    --radius: 16px;
    --nav-h: 72px;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

[data-theme="light"] {
    --bg: #f6f8fc;
    --bg-alt: #ecf0f7;
    --surface: #ffffff;
    --surface-2: #f2f5fb;
    --border: #d9e0ec;
    --text: #0e1522;
    --muted: #55607a;
    --accent: #00a37a;
    --accent-2: #0284c7;
    --accent-soft: rgba(0, 163, 122, 0.1);
    --glow: rgba(0, 163, 122, 0.25);
    --nav-bg: rgba(246, 248, 252, 0.8);
    --shadow: 0 20px 50px rgba(30, 50, 90, 0.12);
}


/* ---------- 2. BASE ---------- */

*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--nav-h);
}

body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    overflow-x: hidden;
    transition: background 0.4s ease, color 0.4s ease;
    -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3 {
    font-family: var(--font-head);
    line-height: 1.15;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font-family: inherit;
    cursor: pointer;
}

::selection {
    background: var(--accent);
    color: #04100c;
}

:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 6px;
}

#bgCanvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.55;
    pointer-events: none;
}

.scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    z-index: 2000;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    box-shadow: 0 0 12px var(--glow);
}

.gradient-text {
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}


/* ---------- 3. NAVIGATION ---------- */

.nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--nav-h);
    padding: 0 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--nav-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    z-index: 1000;
    transition: border-color 0.3s, box-shadow 0.3s;
}

.nav.scrolled {
    border-bottom-color: var(--border);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
}

.logo {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 1px;
}

.logo span {
    color: var(--accent);
}

.menu {
    display: flex;
    gap: 6px;
}

.nav-link {
    position: relative;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    border-radius: 999px;
    transition: color 0.25s, background 0.25s;
}

.nav-link:hover {
    color: var(--text);
}

.nav-link.active {
    color: var(--accent);
    background: var(--accent-soft);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.icon-btn {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 50%;
    font-size: 18px;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
}

.icon-btn:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px var(--glow);
}

.icon-moon { display: none; }
[data-theme="light"] .icon-sun { display: none; }
[data-theme="light"] .icon-moon { display: inline; }

.burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
}

.burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
}

.burger.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.burger.open span:nth-child(2) { opacity: 0; }
.burger.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }


/* ---------- 4. LAYOUT ---------- */

.section {
    position: relative;
    padding: 120px 6%;
    min-height: 100vh;
    display: flex;
    align-items: center;
}

.section.alt {
    background: color-mix(in srgb, var(--bg-alt) 88%, transparent);
}

.container {
    width: 100%;
    max-width: 1150px;
    margin: 0 auto;
}

.container.narrow { max-width: 880px; }
.center { text-align: center; }

.section-head { margin-bottom: 50px; }

.eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
}

.eyebrow .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--glow);
    animation: pulse 2s infinite;
}

.section-title {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -1px;
}

.section-sub {
    margin-top: 14px;
    color: var(--muted);
    font-size: 17px;
    max-width: 560px;
}

.center .section-sub { margin-inline: auto; }

.btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 12px;
    border: 1px solid transparent;
    transition: transform 0.25s var(--ease), box-shadow 0.25s, background 0.25s, border-color 0.25s;
}

.btn-primary {
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    color: #04100c;
    box-shadow: 0 10px 28px var(--glow);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px var(--glow);
}

.btn-ghost {
    background: transparent;
    color: var(--text);
    border-color: var(--border);
}

.btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-3px);
}


/* ---------- 5. HERO ---------- */

.hero {
    padding-top: calc(var(--nav-h) + 60px);
    background:
        radial-gradient(circle at 85% 25%, var(--accent-soft) 0%, transparent 35%),
        radial-gradient(circle at 10% 80%, rgba(56, 189, 248, 0.08) 0%, transparent 35%);
}

.hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 60px;
}

.hero-title {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 18px;
}

.hero-title .greet {
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 500;
    color: var(--muted);
}

.hero-title .name {
    font-size: clamp(42px, 7vw, 78px);
    font-weight: 700;
    letter-spacing: -2px;
}

.typing-line {
    font-family: var(--font-mono);
    font-size: clamp(15px, 2vw, 20px);
    color: var(--accent);
    min-height: 32px;
    margin-bottom: 18px;
}

.caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 3px;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
}

.hero-desc {
    max-width: 520px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.8;
}

.hero-desc strong { color: var(--text); }

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
}

.stats {
    display: flex;
    gap: 40px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
}

.stat strong {
    display: block;
    font-family: var(--font-head);
    font-size: 36px;
    color: var(--text);
}

.stat span {
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.5px;
}

/* Code window */
.code-window {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow), 0 0 60px var(--accent-soft);
    overflow: hidden;
    animation: float 6s ease-in-out infinite;
}

.code-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 14px 18px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
}

.code-bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
}

.code-bar i:nth-child(2) { background: #febc2e; }
.code-bar i:nth-child(3) { background: #28c840; }

.code-bar span {
    margin-left: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
}

.code-body {
    padding: 24px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.9;
    color: var(--text);
    overflow-x: auto;
}

.c-k { color: #c792ea; }
.c-v { color: var(--accent-2); }
.c-p { color: var(--accent); }
.c-s { color: #f6c177; }

[data-theme="light"] .c-k { color: #7c3aed; }
[data-theme="light"] .c-s { color: #b45309; }

.scroll-hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 40px;
    border: 2px solid var(--muted);
    border-radius: 14px;
    opacity: 0.6;
}

.scroll-hint span {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--accent);
    animation: wheel 1.8s infinite;
}


/* ---------- 6. ABOUT ---------- */

.about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    align-items: start;
}

.about-text p {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.9;
    margin-bottom: 18px;
}

.about-text .lead {
    color: var(--text);
    font-size: 23px;
    line-height: 1.6;
}

.about-text strong { color: var(--accent); }

.info-card {
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.info-card h3 {
    font-size: 20px;
    margin-bottom: 18px;
}

.info-card li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 0;
    list-style: none;
    border-bottom: 1px solid var(--border);
}

.info-card li:last-child { border-bottom: 0; padding-bottom: 0; }

.info-card li span {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
}

.info-card li b { font-weight: 600; }


/* ---------- 7. SKILLS ---------- */

.skill-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.skill-card {
    position: relative;
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s;
}

.skill-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 0%), var(--accent-soft), transparent 55%);
    opacity: 0;
    transition: opacity 0.3s;
}

.skill-card:hover {
    border-color: var(--accent);
    box-shadow: 0 16px 40px var(--accent-soft);
}

.skill-card:hover::before { opacity: 1; }

.skill-icon {
    position: relative;
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    margin-bottom: 20px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 17px;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 12px;
}

.skill-card h3 {
    position: relative;
    font-size: 23px;
    margin-bottom: 6px;
}

.skill-card p {
    position: relative;
    color: var(--muted);
    font-size: 15px;
}

.bar {
    position: relative;
    height: 6px;
    margin-top: 22px;
    background: var(--surface-2);
    border-radius: 99px;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    border-radius: 99px;
    transition: width 1.4s var(--ease);
}


/* ---------- 8. ACHIEVEMENTS ---------- */

.timeline {
    position: relative;
    display: grid;
    gap: 26px;
    padding-left: 70px;
}

.timeline::before {
    content: "";
    position: absolute;
    left: 24px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(var(--accent), var(--accent-2), transparent);
}

.timeline-item { position: relative; }

.timeline-num {
    position: absolute;
    left: -70px;
    top: 18px;
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    background: var(--bg);
    border: 2px solid var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 18px var(--glow);
}

.timeline-card {
    padding: 28px 32px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.3s, box-shadow 0.3s;
}

.timeline-card:hover {
    border-color: var(--accent);
    box-shadow: 0 16px 40px var(--accent-soft);
}

.tag {
    display: inline-block;
    padding: 4px 12px;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 99px;
}

.timeline-card h3 {
    font-size: 25px;
    margin-bottom: 8px;
}

.timeline-card p { color: var(--muted); }
.timeline-card strong { color: var(--text); }


/* ---------- 9. GOAL ---------- */

.goal {
    background:
        radial-gradient(circle at 50% 50%, var(--accent-soft) 0%, transparent 45%),
        var(--bg);
}

.quote {
    margin: 10px 0 36px;
    font-family: var(--font-head);
    font-size: clamp(34px, 6vw, 64px);
    font-weight: 700;
    letter-spacing: -1px;
}

.goal-text {
    max-width: 700px;
    margin: 0 auto 18px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.9;
}


/* ---------- 10. CONTACT ---------- */

.contact-links {
    display: grid;
    gap: 16px;
    max-width: 560px;
    margin: 0 auto;
    text-align: left;
}

.contact-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.3s;
}

.contact-card:hover {
    transform: translateX(8px);
    border-color: var(--accent);
    box-shadow: 0 12px 30px var(--accent-soft);
}

.contact-icon {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 12px;
}

.contact-card small {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
}

.contact-card b {
    font-weight: 600;
    word-break: break-all;
}


/* ---------- 11. FOOTER & EXTRAS ---------- */

.footer {
    padding: 36px 6%;
    text-align: center;
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
}

.footer-sub {
    margin-top: 6px;
    font-size: 12px;
    opacity: 0.7;
}

.to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: 46px;
    height: 46px;
    font-size: 20px;
    font-weight: 700;
    color: #04100c;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    border: 0;
    border-radius: 50%;
    box-shadow: 0 10px 26px var(--glow);
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition: opacity 0.3s, transform 0.3s;
    z-index: 900;
}

.to-top.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

.to-top:hover { transform: translateY(-4px); }


/* ---------- 12. ANIMATIONS ---------- */

.reveal {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s var(--ease), transform 0.8s var(--ease);
    transition-delay: var(--delay, 0s);
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}

.tilt { transition: transform 0.2s ease-out, border-color 0.3s, box-shadow 0.3s; }

@keyframes blink { 50% { opacity: 0; } }

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
}

@keyframes pulse {
    0% { box-shadow: 0 0 0 0 var(--glow); }
    70% { box-shadow: 0 0 0 10px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
}

@keyframes wheel {
    0% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(16px); }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
    }

    .reveal { opacity: 1; transform: none; }
}


/* ---------- 13. RESPONSIVE ---------- */

@media (max-width: 960px) {
    .hero-grid,
    .about-grid {
        grid-template-columns: 1fr;
    }

    .hero-visual { max-width: 460px; }

    .skill-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 800px) {
    .burger { display: flex; }

    .menu {
        position: fixed;
        top: var(--nav-h);
        left: 0;
        right: 0;
        flex-direction: column;
        gap: 4px;
        padding: 20px 6% 28px;
        background: var(--nav-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border);
        transform: translateY(-120%);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.4s var(--ease), opacity 0.3s;
    }

    .menu.open {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }

    .nav-link {
        padding: 14px 16px;
        font-size: 16px;
    }

    .section { padding: 100px 6% 70px; min-height: auto; }

    .hero { min-height: 100vh; }

    .stats { gap: 26px; }

    .scroll-hint { display: none; }
}

@media (max-width: 560px) {
    .skill-grid { grid-template-columns: 1fr; }

    .timeline { padding-left: 56px; }
    .timeline::before { left: 18px; }
    .timeline-num { left: -56px; width: 38px; height: 38px; font-size: 12px; }
    .timeline-card { padding: 22px; }

    .hero-buttons .btn { width: 100%; justify-content: center; }
}
