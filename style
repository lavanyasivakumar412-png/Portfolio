/* ========================================
   VARIABLES
======================================== */

:root {
    --bg: #080b12;
    --bg-alt: #0d1119;
    --card: #111722;
    --border: #252b38;
    --text: #ffffff;
    --muted: #aeb5c0;
    --accent: #00e5a8;
}


/* ========================================
   GENERAL
======================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Poppins", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
}


/* ========================================
   NAVIGATION
======================================== */

nav {
    position: fixed;
    top: 0;
    width: 100%;
    height: 70px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 0 7%;

    background: rgba(8, 11, 18, 0.85);
    backdrop-filter: blur(10px);

    border-bottom: 1px solid var(--border);

    z-index: 1000;

    transition: box-shadow 0.3s;
}

nav.scrolled {
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.5);
}

.logo {
    font-size: 22px;
    font-weight: bold;
    color: var(--accent);
    letter-spacing: 1px;
}

.menu {
    display: flex;
    gap: 25px;
}

.menu a {
    position: relative;
    color: #b5bcc8;
    text-decoration: none;
    font-size: 14px;
    padding: 5px 0;
    transition: color 0.3s;
}

.menu a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--accent);
    transition: width 0.3s;
}

.menu a:hover,
.menu a.active {
    color: var(--accent);
}

.menu a:hover::after,
.menu a.active::after {
    width: 100%;
}


/* ========================================
   COMMON PAGE
======================================== */

.page {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 100px 8%;

    border-bottom: 1px solid var(--border);
}

.content {
    width: 100%;
    max-width: 1100px;
}

.small-text {
    color: var(--accent);
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

.content h1 {
    font-size: 60px;
    margin-bottom: 20px;
}

.description {
    color: #a7afbb;
    font-size: 20px;
    line-height: 1.8;
}


/* ========================================
   SCROLL ANIMATION
======================================== */

.reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease, transform 0.8s ease;
}

.reveal.show {
    opacity: 1;
    transform: translateY(0);
}


/* ========================================
   HOME
======================================== */

.home {
    background:
        radial-gradient(circle at 80% 30%, #123b38 0%, transparent 30%),
        var(--bg);
}

.home h1 {
    font-size: 30px;
    color: #b8bec8;
}

.home h2 {
    font-size: 75px;
    margin-bottom: 25px;

    background: linear-gradient(90deg, #00e5a8, #38bdf8);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}


/* ========================================
   BUTTON
======================================== */

.next-btn,
.top-btn {
    margin-top: 30px;

    padding: 15px 25px;

    border: none;

    background: var(--accent);

    color: #06100d;

    font-size: 15px;

    font-weight: bold;

    cursor: pointer;

    border-radius: 6px;

    transition: transform 0.3s, box-shadow 0.3s, background 0.3s;
}

.next-btn:hover,
.top-btn:hover {
    background: white;

    transform: translateY(-3px);

    box-shadow: 0 10px 25px rgba(0, 229, 168, 0.35);
}


/* ========================================
   ABOUT
======================================== */

.about {
    background: var(--bg-alt);
}

.about .content {
    max-width: 850px;
}

.about p:not(.small-text) {
    color: var(--muted);
    font-size: 18px;
    line-height: 1.9;
    margin-bottom: 20px;
}

.about b {
    color: var(--accent);
}

.large-text {
    font-size: 24px !important;
    color: white !important;
}


/* ========================================
   SKILLS
======================================== */

.skills {
    background: var(--bg);
}

.skill-container {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;

    margin-top: 40px;
}

.skill-card {
    padding: 30px;

    background: var(--card);

    border: 1px solid #29313e;

    border-radius: 10px;

    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-8px);

    border-color: var(--accent);

    background: #13201f;

    box-shadow: 0 15px 35px rgba(0, 229, 168, 0.12);
}

.skill-card h3 {
    color: var(--accent);

    font-size: 25px;

    margin-bottom: 10px;
}

.skill-card p {
    color: #8f98a5;
}


/* ========================================
   ACHIEVEMENTS
======================================== */

.achievements {
    background: var(--bg-alt);
}

.achievement-container {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;

    margin-top: 40px;
}

.achievement-card {
    padding: 35px;

    min-height: 230px;

    background: var(--card);

    border: 1px solid #29313e;

    border-radius: 10px;

    transition: 0.3s;
}

.achievement-card:hover {
    transform: translateY(-8px);

    border-color: var(--accent);

    box-shadow: 0 15px 35px rgba(0, 229, 168, 0.12);
}

.achievement-card span {
    color: var(--accent);

    font-size: 13px;
}

.achievement-card h3 {
    font-size: 27px;

    margin: 40px 0 15px;
}

.achievement-card p {
    color: #929aa7;

    line-height: 1.7;
}


/* ========================================
   GOAL
======================================== */

.goal {
    background:
        radial-gradient(circle at 50% 50%, #123b38 0%, transparent 40%),
        var(--bg);
}

.goal .content {
    max-width: 850px;
}

.goal p:not(.small-text) {
    color: var(--muted);

    font-size: 18px;

    line-height: 1.9;

    margin-bottom: 20px;
}

.goal .large-text {
    color: var(--accent) !important;

    font-size: 35px !important;

    font-weight: bold;
}


/* ========================================
   FOOTER
======================================== */

footer {
    padding: 30px;

    text-align: center;

    background: #05070b;

    color: #69717d;

    font-size: 14px;
}


/* ========================================
   MOBILE RESPONSIVE
======================================== */

@media (max-width: 800px) {

    nav {
        height: auto;

        padding: 15px 5%;

        flex-direction: column;

        gap: 15px;
    }

    .menu {
        gap: 12px;

        flex-wrap: wrap;

        justify-content: center;
    }

    .home h2 {
        font-size: 48px;
    }

    .content h1 {
        font-size: 42px;
    }

    .skill-container,
    .achievement-container {
        grid-template-columns: 1fr;
    }

    .page {
        padding: 140px 6% 70px;
    }
}
